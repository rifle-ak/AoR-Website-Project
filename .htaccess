# Art of Rust - Apache configuration
#
# The repository is the document root: upload it to public_html as-is. Every
# request that is not a real file is handled by index.php.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Make the Authorization header visible to PHP (some CGI/FastCGI setups
    # strip it), which the JSON API needs for bearer tokens.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # The JSON API has its own front controller under /api.
    RewriteRule ^api(/.*)?$ - [L]

    # Never route the application source or tooling through the web server.
    RewriteRule ^(app|tools)/ - [F,L]

    # Serve real files and directories untouched.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is a page.
    RewriteRule ^ index.php [L]
</IfModule>

# Block direct access to source, config and dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md|json|lock|mjs)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Enable once your SSL certificate is installed and working.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Assets are requested with a ?v= stamp that changes when they do.
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"

    # Pages are rendered per request.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
