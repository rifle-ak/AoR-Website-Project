# Server Configuration
NODE_ENV=development
PORT=3001

# Rust Server Configuration
RUST_SERVER_IP=188.64.33.62
RUST_SERVER_PORT=28017

# Rust+ Configuration (optional - for real-time data)
ENABLE_RUST_PLUS=false
RUST_PLUS_PORT=28082
RUST_PLAYER_TOKEN=

# Battlemetrics Configuration (optional - for player tracking)
ENABLE_BATTLEMETRICS=false
BATTLEMETRICS_API_KEY=

# Database
DATABASE_PATH=./data/aor.db

# CORS (comma-separated list of allowed origins or * for all)
CORS_ORIGIN=http://localhost:5173,https://artofrust.art

# Steam Authentication
STEAM_API_KEY=your_steam_api_key_here
CALLBACK_URL=http://localhost:3001/api/auth/steam/callback
FRONTEND_URL=http://localhost:5173

# Session & JWT
SESSION_SECRET=your-session-secret-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
